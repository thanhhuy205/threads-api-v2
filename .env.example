NODE_ENV=development
PORT=3000
GLOBAL_PREFIX=api/v1
DATABASE_URL=mysql://root:password@127.0.0.1:3306/threads_api_v2
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=threads_api_v2
CONNECTION_LIMIT=20
CONNECTION_TIMEOUT=5000
IDLE_TIMEOUT=300
CORS_ORIGIN=*
FRONTEND_URL=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=replace-with-a-long-random-secret
ACCESS_EXPIRES=15m
REFRESH_TOKEN_EXPIRES_IN=7d
RESET_PASSWORD_TOKEN_EXPIRES_IN_TEXT=15m
RESEND_VERIFY_EMAIL_TOKEN_EXPIRES_IN_TEXT=15m
RESET_PASSWORD_TOKEN_EXPIRES_IN=15
RESEND_VERIFY_EMAIL_TOKEN_EXPIRES_IN=15

NODEMAILER_HOST=smtp.example.com
NODEMAILER_PORT=587
NODEMAILER_SECURE=false
NODEMAILER_USER=mailer@example.com
NODEMAILER_PASS=replace-me

R2_ENDPOINT=https://account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=threads-media
R2_TOKEN_VALUE=replace-me
R2_ACCOUNT_ID=account-id
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com

PUSHER_APP_ID=app-id
PUSHER_KEY=app-key
PUSHER_SECRET=app-secret
PUSHER_HOST=localhost
PUSHER_PORT=6001
PUSHER_USE_TLS=false
PUSHER_CLUSTER=

OPEN_ROUTER_API_KEY=replace-me
LEONARDO_API_KEY=replace-me
GROQ_API_KEY=replace-me

MONGODB_URI=mongodb://admin:password@localhost:27018/threads-notifications?authSource=admin
MONGODB_USER=admin
MONGODB_PASSWORD=password
MONGODB_NAME=threads-notifications

# --- Microservices (tách ra từ monolith apps/api cũ) ---
# Port phải khớp với cái Kong proxy tới trong apps/config/kong/kong-dev.yaml.
# Host = 0.0.0.0 để process nhận kết nối từ container khác; hai service vẫn
# KHÔNG publish ra host (compose dùng `expose`, không `ports`).
AUTH_SERVICE_HOST=0.0.0.0
AUTH_SERVICE_PORT=3300
USER_SERVICE_HOST=0.0.0.0
USER_SERVICE_PORT=3301

# BẮT BUỘC: mỗi service validate config với skipMissingProperties: false,
# nên thiếu biến này là throw ngay lúc boot. Giá trị: AuthService | UserService
# (compose set riêng cho từng container, ghi đè giá trị ở đây).
MICROSERVICE_NAME=AuthService
