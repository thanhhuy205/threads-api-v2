{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "baseUrl": "./"
  },
  "include": [
    "apps/auth-service/src/**/*.ts",
    "apps/notification-service/src/**/*.ts",
    "apps/post-service/src/**/*.ts",
    "apps/search-service/src/**/*.ts",
    "apps/upload-service/src/**/*.ts",
    "apps/workspace-service/src/**/*.ts",
    "apps/work-service/src/**/*.ts",
    "libs/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "apps/workers/test", "**/*.spec.ts"]
}
