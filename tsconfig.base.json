{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2024"],
    "moduleResolution": "Node",
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "multer"],
    "baseUrl": ".",
    "paths": {
      "@api/*": ["apps/api/src/*"],
      "@libs/*": ["apps/libs/*"],
      "@/config/*": ["apps/libs/core/config/*"],
      "@/providers/*": ["apps/libs/core/providers/*"],
      "@/util/*": ["apps/libs/core/util/*"],
      "@/constants/queue": ["apps/libs/core/constants/queue.ts"],
      "@/constants/resolve-key/*": ["apps/libs/core/constants/resolve-key/*"],
      "@/shared/database/*": ["apps/libs/database/*"],
      "@/shared/redis-version": ["apps/libs/redis-version/index.ts"],
      "@/*": ["apps/api/src/*"]
    }
  }
}
