{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2024"],
    "moduleResolution": "Node",
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "multer"],
    "baseUrl": ".",
    "paths": {
      "@api/*": ["apps/api/src/*"],
      "@notification/*": ["apps/notification-service/src/notification-group/*"],
      "@notification-service/*": ["apps/notification-service/src/*"],
      "@upload/*": ["apps/upload-service/src/upload/*"],
      "@upload-service/*": ["apps/upload-service/src/*"],
      "@libs/*": ["apps/libs/*"],
      "@/common/*": ["apps/libs/common/*"],
      "@/errors/*": ["apps/libs/errors/*"],
      "@/constants/*": ["apps/libs/constants/*"],
      "@/config/*": ["apps/libs/core/config/*"],
      "@/providers/*": ["apps/libs/core/providers/*"],
      "@/util/*": ["apps/libs/core/util/*"],
      "@/constants/queue": ["apps/libs/core/constants/queue.ts"],
      "@/constants/resolve-key/*": ["apps/libs/core/constants/resolve-key/*"],
      "@/shared/database/*": ["apps/api/src/shared/database/*"],
      "@/shared/redis-version": ["apps/libs/redis-version/index.ts"],
      "@/*": ["apps/api/src/*"]
    }
  }
}
