{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2024"],
    "moduleResolution": "Node",
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@api/*": ["apps/api/src/*"],
      "@auth-service/*": ["apps/auth-service/src/*"],
      "@notification/*": ["apps/notification-service/src/notification-group/*"],
      "@notification-service/*": ["apps/notification-service/src/*"],
      "@post-service/*": ["apps/post-service/src/*"],
      "@search-service/*": ["apps/search-service/src/*"],
      "@upload/*": ["apps/upload-service/src/upload/*"],
      "@upload-service/*": ["apps/upload-service/src/*"],
      "@user-service/*": ["apps/user-service/src/*"],
      "@work-service/*": ["apps/work-service/src/*"],
      "@libs/cache/*": ["apps/libs/core/src/cache/*"],
      "@libs/core/config/*": ["apps/libs/common/src/config/*"],
      "@libs/core/constants/*": ["apps/libs/common/src/constants/*"],
      "@libs/core/providers/*": ["apps/libs/core/src/providers/*"],
      "@libs/*": ["apps/libs/*"],
      "@/common/*": ["apps/libs/common/src/*"],
      "@/bootstrap/*": ["apps/libs/common/src/bootstrap/*"],
      "@/errors/*": ["apps/libs/common/src/errors/*"],
      "@/constants/*": ["apps/libs/common/src/constants/*"],
      "@/config/*": ["apps/libs/common/src/config/*"],
      "@/providers/*": ["apps/libs/core/src/providers/*"],
      "@/util/*": ["apps/libs/core/util/*"],
      "@/constants/queue": ["apps/libs/common/src/constants/queue.ts"],
      "@/constants/resolve-key/*": ["apps/libs/common/src/constants/resolve-key/*"],
      "@/shared/database/*": ["apps/api/src/shared/database/*"],
      "@/shared/redis-version": ["apps/libs/core/src/redis-version/index.ts"],
      "@/*": ["apps/api/src/*"]
    }
  }
}
