generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserRoleType {
  USER
  ADMIN
  MODERATOR
  WORKSPACE_OWNER
}

enum PostType {
  POST
  ANNOUNCEMENT
  DECIDE
}

enum QueueStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum VerificationCodeType {
  FORGOT_PASSWORD
  RESET_PASSWORD
  VERIFY_ACCOUNT
}

enum JobStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum ReplyPermission {
  EVERYONE
  FOLLOWERS
  FOLLOWING
  MENTIONED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DEACTIVATED
}

enum VisibilityPost {
  WORKSPACE
  GROUP
  CUSTOM
  ONLY_ME
}

enum PermissionScope {
  WORKSPACE
  GROUP
}

enum Position {
  SOFTWARE_ENGINEER
  SENIOR_SOFTWARE_ENGINEER
  INTERN_SOFTWARE_ENGINEER
  TECH_LEAD
  DATA_SCIENTIST
  PRODUCT_MANAGER
  DESIGNER
  HR
  MARKETING_SPECIALIST
  SALES_REPRESENTATIVE
  CUSTOMER_SUPPORT
  CONTENT_CREATOR
  BUSINESS_ANALYST
  CTO
  CEO
  FOUNDER
  OTHER
}

enum ActionType {
  POST_CREATED
  POST_DELETED
  LIKE_CREATED
  FLOW_FOLLOWER_CREATED
  FOLLOW_FOLLOWING_CREATED
  QUOTE_CREATED
  QUOTE_DELETED
  SHARE_CREATED
  SHARE_DELETED
  GENERATE_POST_BEAUTIFUL
  GENERATE_CAPTION_MD
  GENERATE_IMAGE
}

enum InteractionType {
  HIDE
  SAVE
}

enum PostMediaType {
  IMAGE
  VIDEO
  HLS
  VOICE
  GIF
  OTHER
}

enum PostMediaStatus {
  TEMPORARY
  UPLOADING
  UPLOADED
  FAILED
  DELETED
}

model Role {
  id              String           @id @default(nanoid())
  name            String           @unique @db.VarChar(20)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([name], map: "idx_roles_name")
  @@map("roles")
}

model UserRole {
  id        String   @id @default(nanoid())
  roleId    String   @map("role_id")
  role      Role     @relation(fields: [roleId], references: [id])
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId], map: "idx_user_roles_user_id")
  @@index([roleId], map: "idx_user_roles_role_id")
  @@map("user_roles")
}

model Permission {
  id                  String               @id @default(nanoid())
  name                String               @unique @db.VarChar(50)
  code                String               @unique @db.VarChar(50)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  rolePermissions     RolePermission[]
  positionPermissions PositionPermission[]

  @@index([code], map: "idx_permissions_code")
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(nanoid())
  role         Role       @relation(fields: [roleId], references: [id])
  roleId       String     @map("role_id")
  permission   Permission @relation(fields: [permissionId], references: [id])
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([roleId], map: "idx_role_permissions_role_id")
  @@index([permissionId], map: "idx_role_permissions_permission_id")
  @@map("role_permissions")
}

model User {
  id       String @id @default(nanoid())
  email    String @unique @db.VarChar(255)
  username String @unique @db.VarChar(100)
  password String @db.VarChar(255)

  name String? @map("name") @db.VarChar(100)

  bio        String?    @db.Text
  avatar     String?    @db.VarChar(255)
  verifiedAt DateTime?  @map("verified_at")
  status     UserStatus @default(ACTIVE)

  location     String? @db.VarChar(255)
  website      String? @db.VarChar(255)
  labelWebsite String? @map("label_website") @db.VarChar(255)

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  posts             Post[]
  refreshTokens     RefreshToken[]
  verificationCodes VerificationCode[]

  likes                Like[]
  userRoles            UserRole[]
  postMentions         PostMention[]
  votes                Vote[]
  postInteractions     PostInteraction[]
  announcementReceipts AnnouncementReceipt[]
  userTeams            UserTeam[]
  groupTeams           GroupTeam[]
  userPositions        UserPosition[]
  overviewDeclines     OverviewDecline[]

  @@index([email], map: "idx_users_email")
  @@index([name], map: "idx_users_name")
  @@index([username], map: "idx_users_username")
  @@index([deletedAt], map: "idx_users_deleted_at")
  @@fulltext([username, name], map: "idx_users_username_name_fulltext")
  @@map("users")
}

model UserPosition {
  id                   Int    @id @default(autoincrement())
  userId               String @map("user_id")
  positionPermissionId Int    @map("position_permission_id")

  position  Position @default(OTHER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user               User               @relation(fields: [userId], references: [id])
  positionPermission PositionPermission @relation(fields: [positionPermissionId], references: [id])

  @@unique([userId, positionPermissionId], map: "uq_user_positions_user_id_position_permission_id")
  @@index([userId], map: "idx_user_positions_user_id")
  @@index([positionPermissionId], map: "idx_user_positions_position_permission_id")
  @@map("user_positions")
}

model PositionPermission {
  id           Int             @id @default(autoincrement())
  position     Position
  permissionId String          @map("permission_id")
  scope        PermissionScope @default(WORKSPACE)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  permission    Permission     @relation(fields: [permissionId], references: [id])
  userPositions UserPosition[]

  @@unique([position, permissionId, scope], map: "uq_position_permissions_position_permission_scope")
  @@index([permissionId], map: "idx_position_permissions_permission_id")
  @@index([position, scope], map: "idx_position_permissions_position_scope")
  @@map("position_permissions")
}

model AnnouncementReceipt {
  id             Int       @id @default(autoincrement())
  postId         Int       @map("post_id")
  userId         String    @map("user_id")
  readAt         DateTime? @map("read_at")
  acknowledgedAt DateTime? @map("acknowledged_at")

  post Post @relation(fields: [postId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
  @@index([userId, readAt])
  @@map("announcement_receipts")
}

model PostInteraction {
  id        Int             @id @default(autoincrement())
  userId    String          @map("user_id")
  postId    Int             @map("post_id")
  type      InteractionType @map("type_enum")
  createdAt DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])

  @@unique([userId, postId, type], map: "uq_saves_user_post_type")
  @@index([userId], map: "idx_saves_user_id")
  @@index([postId], map: "idx_saves_post_id")
  @@map("post_interactions")
}

model VerificationCode {
  id        Int                  @id @default(autoincrement())
  userId    String               @map("user_id")
  type      VerificationCodeType
  tokenHash String               @unique @db.VarChar(100)
  expiresAt DateTime             @map("expires_at")
  usedAt    DateTime?            @map("used_at")
  createdAt DateTime             @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, type, createdAt], map: "idx_verification_codes_user_type_created")
  @@index([expiresAt], map: "idx_verification_codes_expires_at")
  @@index([usedAt], map: "idx_verification_codes_used_at")
  @@map("verification_codes")
}

model Post {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(nanoid()) @map("public_id")
  userId   String @map("user_id")

  content     String   @db.Text
  contentJson Json?    @map("content_json")
  type        PostType @default(POST)

  // Thread structure
  parentId   Int? @map("parent_id") // Reply trực tiếp
  rootPostId Int? @map("root_post_id") // Bài gốc của cuộc thảo luận

  parentPublicId String? @map("parent_public_id")
  rootPublicId   String? @map("root_public_id")

  // Repost / Quote
  originPostId   Int?    @map("origin_post_id")
  originPublicId String? @map("origin_public_id")
  isQuote        Boolean @default(false) @map("is_quote")

  // Access and interaction rules
  visibility      VisibilityPost  @default(WORKSPACE)
  replyPermission ReplyPermission @default(EVERYONE) @map("reply_permission")
  commentsEnabled Boolean         @default(true)

  // Official announcement
  isPinned                Boolean   @default(false) @map("is_pinned")
  requiresAcknowledgement Boolean   @default(false) @map("requires_acknowledgement")
  publishedAt             DateTime? @map("published_at")
  // Time post is scheduled to be published, if null, post is published immediately
  scheduledTimeFrom       DateTime? @map("scheduled_time_from") @db.Time(0)
  scheduledTimeTo         DateTime? @map("scheduled_time_to") @db.Time(0)
  dateRangeFrom           DateTime? @map("date_range_from")
  dateRangeTo             DateTime? @map("date_range_to")

  isDecline Boolean @default(false) @map("is_decline") // Xác nhận đã kết thúc cuộc thảo luận, không cho phép thêm bình luận mới, nhưng vẫn hiển thị các bình luận cũ

  groupTeamId Int?       @map("group_team_id")
  groupTeam   GroupTeam? @relation(fields: [groupTeamId], references: [id])

  // Survey
  isSurvey   Boolean   @default(false) @map("is_survey")
  deadlineAt DateTime? @map("deadline_at")

  // Snapshot
  userSnapshot Json? @map("user_snapshot")

  // Counters
  likesCount                Int @default(0) @map("likes_count")
  repliesCount              Int @default(0) @map("replies_count")
  repostsCountAndQuoteCount Int @default(0) @map("reposts_and_quotes_count")
  viewsCount                Int @default(0) @map("views_count")

  // Lifecycle
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Author
  user User @relation(fields: [userId], references: [id])

  // Thread relations
  parent   Post?  @relation("PostParent", fields: [parentId], references: [id])
  children Post[] @relation("PostParent")

  root   Post?  @relation("PostRoot", fields: [rootPostId], references: [id])
  thread Post[] @relation("PostRoot")

  // Repost / Quote relations
  origin      Post?  @relation("PostOrigin", fields: [originPostId], references: [id])
  derivatives Post[] @relation("PostOrigin")

  // Feature relations
  media                PostMedia[]
  mentions             PostMention[]
  topicsPosts          TopicsPost[]
  likes                Like[]
  poll                 Poll?
  postInteractions     PostInteraction[]
  announcementReceipts AnnouncementReceipt[]
  overviewDeclines     OverviewDecline[]

  // Indexes
  @@index([userId, createdAt])
  @@index([parentId])
  @@index([rootPostId])
  @@index([originPostId])
  @@index([groupTeamId])
  @@index([createdAt])
  @@fulltext([content], map: "idx_posts_content_fulltext")
  @@map("posts")
}

model OverviewDecline {
  id     Int    @id @default(autoincrement())
  postId Int    @map("post_id")
  userId String @map("user_id")

  context String @db.Text
  reason  String @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([postId, userId], map: "uq_overview_declines_post_user")
  @@index([postId], map: "idx_overview_declines_post_id")
  @@index([userId], map: "idx_overview_declines_user_id")
  @@map("overview_declines")
}

model GroupTeam {
  id        Int        @id @default(autoincrement())
  publicId  String     @unique @default(nanoid()) @map("public_id")
  name      String     @unique @db.VarChar(255)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  userTeams UserTeam[]
  posts     Post[]

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String @map("created_by_id")

  @@index([name], map: "idx_group_teams_name")
  @@map("group_teams")
}

model UserTeam {
  id        Int       @id @default(autoincrement())
  userId    String    @map("user_id")
  teamId    Int       @map("team_id")
  position  Position? @default(OTHER)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User      @relation(fields: [userId], references: [id])
  team GroupTeam @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId], map: "uq_user_teams_user_id_team_id")
  @@index([userId], map: "idx_user_teams_user_id")
  @@index([teamId], map: "idx_user_teams_team_id")
  @@map("user_teams")
}

model Poll {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  isExpired Boolean  @default(false) @map("is_expired")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  voteCount Int      @default(0) @map("vote_count")

  post        Post         @relation(fields: [postId], references: [id], onDelete: Restrict)
  pollOptions PollOption[]
  votes       Vote[]

  @@unique([postId], map: "uq_polls_post_id")
  @@index([postId], map: "idx_polls_post_id")
  @@map("polls")
}

model PollOption {
  id         Int      @id @default(autoincrement())
  pollId     Int      @map("poll_id")
  optionText String   @map("option_text") @db.VarChar(255)
  votesCount Int      @default(0) @map("votes_count")
  createdAt  DateTime @default(now()) @map("created_at")

  poll  Poll   @relation(fields: [pollId], references: [id])
  votes Vote[]

  @@unique([id, pollId], map: "uq_poll_options_id_poll_id") // đảm bảo mỗi option chỉ thuộc về một poll duy nhất
  @@index([pollId], map: "idx_poll_options_poll_id")
  @@map("poll_options")
}

model Vote {
  id           Int      @id @default(autoincrement())
  userId       String   @map("user_id")
  pollId       Int      @map("poll_id")
  pollOptionId Int      @map("poll_option_id")
  createdAt    DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id])
  pollOption PollOption @relation(fields: [pollOptionId], references: [id])
  poll       Poll       @relation(fields: [pollId], references: [id])

  @@unique([userId, pollOptionId], map: "uq_votes_user_poll_option")
  @@unique([userId, pollId], map: "uq_votes_user_poll") // đảm bảo mỗi người dùng chỉ được vote một lần cho mỗi poll
  @@index([userId], map: "idx_votes_user_id")
  @@index([pollOptionId], map: "idx_votes_poll_option_id")
  @@map("votes")
}

model PostMedia {
  id        Int              @id @default(autoincrement())
  postId    Int?             @map("post_id")
  url       String           @db.VarChar(2048)
  uploadUrl String?          @map("upload_url") @db.VarChar(2048) // url dùng để upload file, chỉ tồn tại khi media đang ở trạng thái TEMPORARY hoặc UPLOADING
  assetId   String?          @map("asset_id") @db.VarChar(255) // id của file trên dịch vụ lưu trữ, dùng để quản lý và xóa file khi cần thiết
  type      PostMediaType?   @map("type_enum")
  width     Int?
  height    Int?
  createdAt DateTime         @default(now()) @map("created_at")
  key       String           @unique @db.VarChar(255)
  status    PostMediaStatus? @default(TEMPORARY) @map("status_enum")
  post      Post?            @relation(fields: [postId], references: [id])

  @@index([postId], map: "idx_post_media_post_id")
  @@map("post_media")
}

model PostMention {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([postId, userId], map: "uq_post_mentions_post_user")
  @@index([postId], map: "idx_post_mentions_post_id")
  @@index([userId], map: "idx_post_mentions_user_id")
  @@map("post_mentions")
}

model Like {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  postId    String   @map("post_id")
  isLike    Boolean  @default(false) @map("is_like")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [publicId])

  @@unique([userId, postId], map: "uq_likes_user_post")
  @@index([userId], map: "idx_likes_user_id")
  @@index([postId], map: "idx_likes_post_id")
  @@map("likes")
}

model Topic {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(255)
  count     Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  topicsPosts TopicsPost[] @relation("TopicPublic")

  @@index([name], map: "idx_topics_name")
  @@index([count], map: "idx_topics_count")
  @@fulltext([name], map: "idx_topics_name_fulltext")
  @@map("topics")
}

model TopicsPost {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  topicId   Int?     @map("topic_id")
  createdAt DateTime @default(now()) @map("created_at")

  post  Post   @relation(fields: [postId], references: [id])
  topic Topic? @relation("TopicPublic", fields: [topicId], references: [id])

  @@unique([postId, topicId], map: "uq_topics_posts_post_topic")
  @@index([postId], map: "idx_topics_posts_post_id")
  @@index([topicId], map: "idx_topics_posts_topic_id")
  @@index([postId, topicId], map: "idx_topics_posts_post_topic")
  @@map("topics_posts")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  token     String   @unique @db.VarChar(512)
  expireAt  DateTime @map("expire_at")
  sessionId String   @map("session_id") @db.VarChar(255)

  revokedAt DateTime? @map("revoked_at")

  userAgent String @default("unknown") @map("user_agent") @db.VarChar(512)
  ip        String @default("unknown") @db.VarChar(45)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId], map: "idx_refresh_tokens_user_id")
  @@index([expireAt], map: "idx_refresh_tokens_expire_at")
  @@index([sessionId], map: "idx_refresh_tokens_session_id")
  @@map("refresh_tokens")
}
