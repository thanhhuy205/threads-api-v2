{
  "name": "@purse/account-service",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "pretypecheck": "prisma generate --config prisma.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prebuild": "prisma generate --config prisma.config.ts",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node --env-file=../../.env --env-file=.env dist/main.js",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "test": "jest --config jest.config.json",
    "test:keycloak": "jest --config jest.config.json test/keycloak",
    "test:keycloak:spec": "jest --config jest.config.json test/keycloak/spec",
    "test:keycloak:e2e": "jest --config jest.config.json test/keycloak/e2e"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@keycloak/keycloak-admin-client": "^26.8.1",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@purse/auth": "workspace:*",
    "@purse/common": "workspace:*",
    "@purse/core": "workspace:*",
    "@purse/observability": "workspace:*",
    "@purse/proto": "workspace:*",
    "@purse/redis": "workspace:*",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.81.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.5.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "ms": "^2.1.3",
    "nest-winston": "^1.10.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/nock": "^11.1.0",
    "@types/node": "^22.20.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "nock": "^13.5.6",
    "prisma": "7.8.0",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.1",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.13",
    "typescript": "^5.8.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
