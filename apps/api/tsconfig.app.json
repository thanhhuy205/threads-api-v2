{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "outDir": "../../dist/apps/api",
    "paths": {
      "@/*": ["src/*"],
      "@prisma/client": ["apps/api/generated/prisma"]
    }
  },
  "include": ["src/**/*.ts", "../libs/**/*.ts", "prisma/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
