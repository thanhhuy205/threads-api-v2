generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum DepartmentMembershipLevel {
  INTERN
  JUNIOR
  MID_LEVEL
  SENIOR
  LEAD
  MANAGER
  DIRECTOR
  EXECUTIVE
  FOUNDER
  OTHER
}

enum JobFunction {
  ENGINEERING
  PRODUCT
  DESIGN
  DATA
  DEVOPS
  SECURITY
  QA
  HR
  MARKETING
  SALES
  CUSTOMER_SUPPORT
  FINANCE
  OPERATIONS
  OTHER
}

model Department {
  id          Int                    @id @default(autoincrement())
  name        String                 @unique @db.VarChar(255)
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  memberships DepartmentMembership[]

  @@index([name], map: "idx_departments_name")
  @@map("departments")
}

model DepartmentMembership {
  id           Int            @id @default(autoincrement())
  userId       String         @map("user_id")
  departmentId Int            @map("department_id")
  roleId       Int            @map("role_id")
  jobFunction  JobFunction    @map("job_function")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  department   Department     @relation(fields: [departmentId], references: [id])
  role         DepartmentRole @relation(fields: [roleId], references: [id])

  @@unique([userId, departmentId], map: "uq_department_memberships_user_id_department_id")
  @@index([userId], map: "idx_department_memberships_user_id")
  @@index([departmentId], map: "idx_department_memberships_department_id")
  @@map("department_memberships")
}

model DepartmentRole {
  id          Int                        @id @default(autoincrement())
  code        DepartmentMembershipLevel  @unique
  name        String
  permissions DepartmentRolePermission[]
  memberships DepartmentMembership[]

  @@index([name], map: "idx_roles_name")
  @@map("department_roles")
}

model DepartmentRolePermission {
  roleId       Int                  @map("role_id")
  permissionId String               @map("permission_id")
  role         DepartmentRole       @relation(fields: [roleId], references: [id])
  permission   DepartmentPermission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId], map: "idx_role_permissions_permission_id")
  @@map("role_department_permissions")
}

model DepartmentPermission {
  id          String                     @id @default(uuid())
  name        String                     @unique @db.VarChar(255)
  createdAt   DateTime                   @default(now()) @map("created_at")
  updatedAt   DateTime                   @updatedAt @map("updated_at")
  permissions DepartmentRolePermission[]

  @@index([name], map: "idx_permissions_name")
  @@map("department_permissions")
}

model HistoryPosition {
  id                    Int                    @id @default(autoincrement())
  userId                String                 @map("user_id")
  title                 String                 @db.VarChar(255)
  timeStart             DateTime               @map("time_start")
  details               String?                @db.Text
  verifyByUserId        String?                @map("verify_by_user_id")
  verifiedAt            DateTime?              @map("verified_at")
  historyPositionSkills HistoryPositionSkill[]
  createdAt             DateTime               @default(now()) @map("created_at")

  @@index([userId], map: "idx_history_positions_user_id")
  @@map("history_positions")
}

model HistoryPositionSkill {
  historyPositionId Int             @map("history_position_id")
  skillId           Int             @map("skill_id")
  historyPosition   HistoryPosition @relation(fields: [historyPositionId], references: [id])
  skill             Skill           @relation(fields: [skillId], references: [id])

  @@id([historyPositionId, skillId])
  @@index([skillId], map: "idx_history_position_skills_skill_id")
  @@map("history_position_skills")
}

model Skill {
  id                    Int                    @id @default(autoincrement())
  name                  String                 @unique @db.VarChar(100)
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  historyPositionSkills HistoryPositionSkill[]

  @@index([name], map: "idx_skills_name")
  @@map("skills")
}

model Professional {
  id                Int      @id @default(autoincrement())
  userId            String   @map("user_id")
  countAnswers      Int      @default(0) @map("count_answers")
  timeAverageAnswer Float    @default(0) @map("time_average_answer")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([userId], map: "idx_professionals_user_id")
  @@map("professionals")
}
