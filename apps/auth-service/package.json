{
  "name": "@purse/auth-service",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "pretypecheck": "prisma generate --config prisma.config.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "prebuild": "prisma generate --config prisma.config.ts",
    "build": "tsc -p tsconfig.app.json && tsc-alias -p tsconfig.app.json",
    "dev": "tsc --watch -p tsconfig.app.json"
  },
  "dependencies": {
    "@purse/common": "workspace:*",
    "@purse/core": "workspace:*",
    "@purse/proto": "workspace:*",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.2.3",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/adapter-mariadb": "7.8.0",
    "@prisma/client": "7.8.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.81.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.5.0",
    "express-request-id": "^3.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mariadb": "^3.4.5",
    "ms": "^2.1.3",
    "nest-winston": "^1.10.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^22.20.1",
    "prisma": "7.8.0",
    "typescript": "^5.8.0"
  }
}
