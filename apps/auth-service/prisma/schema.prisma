generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum VerificationCodeType {
  FORGOT_PASSWORD
  RESET_PASSWORD
  VERIFY_ACCOUNT
}

enum PermissionScope {
  WORKSPACE
  GROUP
}

model Role {
  id          String           @id @default(nanoid())
  name        String           @unique @db.VarChar(20)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  permissions RolePermission[]
  userRoles   UserRole[]

  @@index([name], map: "idx_roles_name")
  @@map("roles")
}

model UserRole {
  id        String   @id @default(nanoid())
  roleId    String   @map("role_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  role Role @relation(fields: [roleId], references: [id])

  @@index([userId], map: "idx_user_roles_user_id")
  @@index([roleId], map: "idx_user_roles_role_id")
  @@map("user_roles")
}

model Permission {
  id        String   @id @default(nanoid())
  name      String   @unique @db.VarChar(50)
  code      String   @unique @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([code], map: "idx_permissions_code")
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(nanoid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  role         Role     @relation(fields: [roleId], references: [id])

  @@index([roleId], map: "idx_role_permissions_role_id")
  @@index([permissionId], map: "idx_role_permissions_permission_id")
  @@map("role_permissions")
}

model VerificationCode {
  id        Int                  @id @default(autoincrement())
  userId    String               @map("user_id")
  type      VerificationCodeType
  tokenHash String               @unique @map("token_hash") @db.VarChar(100)
  expiresAt DateTime             @map("expires_at")
  usedAt    DateTime?            @map("used_at")
  createdAt DateTime             @default(now()) @map("created_at")

  @@index([userId, type, createdAt], map: "idx_verification_codes_user_type_created")
  @@index([expiresAt], map: "idx_verification_codes_expires_at")
  @@index([usedAt], map: "idx_verification_codes_used_at")
  @@map("verification_codes")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    String    @map("user_id")
  token     String    @unique @db.VarChar(512)
  expireAt  DateTime  @map("expire_at")
  sessionId String    @map("session_id") @db.VarChar(255)
  revokedAt DateTime? @map("revoked_at")
  userAgent String    @default("unknown") @map("user_agent") @db.VarChar(512)
  ip        String    @default("unknown") @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([userId], map: "idx_refresh_tokens_user_id")
  @@index([expireAt], map: "idx_refresh_tokens_expire_at")
  @@index([sessionId], map: "idx_refresh_tokens_session_id")
  @@map("refresh_tokens")
}
