generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserRoleType {
  USER
  ADMIN
  MODERATOR
}

enum PostType {
  POST
  REPLY
  REPOST
  QUOTE
}

enum FollowStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum QueueStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum VerificationCodeType {
  FORGOT_PASSWORD
  RESET_PASSWORD
  VERIFY_ACCOUNT
}

enum JobStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum ReplyPermission {
  EVERYONE
  FOLLOWERS
  FOLLOWING
  MENTIONED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DEACTIVATED
}

enum ReportTargetType {
  POST
  USER
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum VisibilityPost {
  PUBLIC
  FRIEND
  PRIVATE
}

enum ActionType {
  POST_CREATED
  POST_DELETED
  LIKE_CREATED
  FLOW_FOLLOWER_CREATED
  FOLLOW_FOLLOWING_CREATED
  QUOTE_CREATED
  QUOTE_DELETED
  SHARE_CREATED
  SHARE_DELETED
  GENERATE_POST_BEAUTIFUL
  GENERATE_CAPTION_MD
  GENERATE_IMAGE
}

enum InteractionType {
  HIDE
  SAVE
}

enum PostMediaType {
  IMAGE
  VIDEO
  HLS
  VOICE
  GIF
  OTHER
}

enum PostMediaStatus {
  TEMPORARY
  UPLOADING
  UPLOADED
  FAILED
  DELETED
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum UserRestrictionType {
  POSTING
  AI_GENERATION_CAPTION
  AI_GENERATION_IMAGE
}

model Role {
  id              String           @id @default(cuid())
  name            String           @unique @db.VarChar(20)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([name], map: "idx_roles_name")
  @@map("roles")
}

model UserRole {
  id        String   @id @default(cuid())
  roleId    String   @map("role_id")
  role      Role     @relation(fields: [roleId], references: [id])
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId], map: "idx_user_roles_user_id")
  @@index([roleId], map: "idx_user_roles_role_id")
  @@map("user_roles")
}

model Permission {
  id              String           @id @default(cuid())
  name            String           @unique @db.VarChar(50)
  code            String           @unique @db.VarChar(50)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  rolePermissions RolePermission[]

  @@index([code], map: "idx_permissions_code")
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  role         Role       @relation(fields: [roleId], references: [id])
  roleId       String     @map("role_id")
  permission   Permission @relation(fields: [permissionId], references: [id])
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([roleId], map: "idx_role_permissions_role_id")
  @@index([permissionId], map: "idx_role_permissions_permission_id")
  @@map("role_permissions")
}

model User {
  id       String @id @default(cuid())
  email    String @unique @db.VarChar(255)
  username String @unique @db.VarChar(100)
  password String @db.VarChar(255)

  name String? @map("name") @db.VarChar(100)

  bio         String?    @db.Text
  avatar      String?    @db.VarChar(255)
  verifiedAt  DateTime?  @map("verified_at")
  status      UserStatus @default(ACTIVE)
  bannedUntil DateTime?  @map("banned_until")

  followersCount Int @default(0) @map("followers_count")
  followingCount Int @default(0) @map("following_count")
  postsCount     Int @default(0) @map("posts_count")

  isPrivate    Boolean @default(false) @map("is_private")
  location     String? @db.VarChar(255)
  website      String? @db.VarChar(255)
  labelWebsite String? @map("label_website") @db.VarChar(255)

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  posts                Post[]
  refreshTokens        RefreshToken[]
  verificationCodes    VerificationCode[]
  follows              Follow[]              @relation("FollowUser")
  followers            Follow[]              @relation("FollowFollowing")
  likes                Like[]
  friendRequests       FriendRequest[]       @relation("FriendRequestSender")
  receivedRequests     FriendRequest[]       @relation("FriendRequestReceiver")
  userRoles            UserRole[]
  userRestrictions     UserRestriction[]
  reports              Report[]              @relation("UserReports")
  postMentions         PostMention[]
  userActionLogs       UserActionLog[]
  limitActionAIs       LimitActionAI[]
  votes                Vote[]
  postInteractions     PostInteraction[]

  @@index([email], map: "idx_users_email")
  @@index([name], map: "idx_users_name")
  @@index([username], map: "idx_users_username")
  @@index([deletedAt], map: "idx_users_deleted_at")
  @@index([bannedUntil], map: "idx_users_banned_until")
  @@index([status, bannedUntil], map: "idx_users_status_banned_until")
  @@fulltext([username, name], map: "idx_users_username_name_fulltext")
  @@map("users")
}

model PostInteraction {
  id        Int             @id @default(autoincrement())
  userId    String          @map("user_id")
  postId    Int             @map("post_id")
  type      InteractionType @map("type_enum")
  createdAt DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])

  @@unique([userId, postId, type], map: "uq_saves_user_post_type")
  @@index([userId], map: "idx_saves_user_id")
  @@index([postId], map: "idx_saves_post_id")
  @@map("post_interactions")
}

model Report {
  id               String           @id @default(cuid())
  reporterId       String           @map("reporter_id")
  targetType       ReportTargetType @map("target_type")
  targetId         String           @map("target_id") @db.VarChar(255)
  reason           String           @db.Text
  status           ReportStatus     @default(PENDING)
  assistantNote    String?          @map("assistant_note") @db.Text
  confidence       Decimal?         @db.Decimal(3, 2) // 0.00 - 1.00, chỉ số này do hệ thống tự động đánh giá dựa trên nội dung report 
  // và lịch sử của người báo cáo, giúp admin ưu tiên xử lý những report có độ tin cậy cao
  isDisinformation Boolean          @default(false) @map("is_disinformation") // bot đánh dấu nội dung có khả năng sai sự thật cao, giúp admin ưu tiên xử lý và có thể áp dụng biện pháp nhẹ nhàng hơn như ẩn bài viết khỏi feed trước khi quyết định xóa hoàn toàn
  adminNote        String?          @map("admin_note") @db.Text
  createdAt        DateTime         @default(now()) @map("created_at")

  reporter User @relation("UserReports", fields: [reporterId], references: [id])

  @@index([reporterId], map: "idx_reports_reporter_id")
  @@index([targetType, targetId], map: "idx_reports_target")
  @@index([status, createdAt], map: "idx_reports_status_created_at")
  @@map("reports")
}

model VerificationCode {
  id        Int                  @id @default(autoincrement())
  userId    String               @map("user_id")
  type      VerificationCodeType
  tokenHash String               @unique @db.VarChar(100)
  expiresAt DateTime             @map("expires_at")
  usedAt    DateTime?            @map("used_at")
  createdAt DateTime             @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, type, createdAt], map: "idx_verification_codes_user_type_created")
  @@index([expiresAt], map: "idx_verification_codes_expires_at")
  @@index([usedAt], map: "idx_verification_codes_used_at")
  @@map("verification_codes")
}

model Post {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(cuid()) @map("public_id")

  userId      String @map("user_id")
  content     String @db.Text
  contentJson Json?  @map("content_json")

  type       PostType       @default(POST)
  visibility VisibilityPost @default(PUBLIC)

  parentId     Int? @map("parent_id") // reply -> parent
  originPostId Int? @map("origin_post_id") // repost/quote -> original
  rootPostId   Int? @map("root_post_id") // conversation root

  parentPublicId String? @map("parent_public_id")
  originPublicId String? @map("origin_public_id")
  rootPublicId   String? @map("root_public_id")

  userSnapshot    Json?           @map("user_snapshot")
  replyPermission ReplyPermission @default(EVERYONE) @map("reply_permission")

  likesCount                Int @default(0) @map("likes_count")
  repliesCount              Int @default(0) @map("replies_count")
  repostsCountAndQuoteCount Int @default(0) @map("reposts_and_quotes_count")
  viewsCount                Int @default(0) @map("views_count")

  isQuote  Boolean @default(false) @map("is_quote")
  isPinned Boolean @default(false) @map("is_pinned")
  isGhost  Boolean @default(false) @map("is_ghost")
  isSurvey Boolean @default(false) @map("is_survey")

  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  parent   Post?  @relation("PostParent", fields: [parentId], references: [id])
  children Post[] @relation("PostParent")

  origin      Post?  @relation("PostOrigin", fields: [originPostId], references: [id])
  derivatives Post[] @relation("PostOrigin")

  root   Post?  @relation("PostRoot", fields: [rootPostId], references: [id])
  thread Post[] @relation("PostRoot")

  isHidden         Boolean @default(false) @map("is_hidden") // bot ẩn bài viết khỏi feed, chỉ hiển thị khi truy cập trực tiếp, dùng cho trường hợp bài viết bị report nhiều lần hoặc vi phạm chính sách nhưng chưa đến mức xóa hoàn toàn
  isDisinformation Boolean @default(false) @map("is_disinformation") // bot đánh dấu bài viết có nội dung sai

  media                 PostMedia[]
  mentions              PostMention[]
  topicsPosts           TopicsPost[]
  likes                 Like[]
  poll                  Poll?
  postInteractions      PostInteraction[]

  @@index([userId, createdAt])
  @@index([parentId])
  @@index([originPostId])
  @@index([rootPostId])
  @@index([createdAt])
  @@index([publicId], map: "idx_posts_public_id")
  @@fulltext([content], map: "idx_posts_content_fulltext")
  @@map("posts")
}

model Poll {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  isExpired Boolean  @default(false) @map("is_expired")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  voteCount Int      @default(0) @map("vote_count")

  post        Post         @relation(fields: [postId], references: [id], onDelete: Restrict)
  pollOptions PollOption[]
  votes       Vote[]

  @@unique([postId], map: "uq_polls_post_id")
  @@index([postId], map: "idx_polls_post_id")
  @@map("polls")
}

model PollOption {
  id         Int      @id @default(autoincrement())
  pollId     Int      @map("poll_id")
  optionText String   @map("option_text") @db.VarChar(255)
  votesCount Int      @default(0) @map("votes_count")
  createdAt  DateTime @default(now()) @map("created_at")

  poll  Poll   @relation(fields: [pollId], references: [id])
  votes Vote[]

  @@unique([id, pollId], map: "uq_poll_options_id_poll_id") // đảm bảo mỗi option chỉ thuộc về một poll duy nhất
  @@index([pollId], map: "idx_poll_options_poll_id")
  @@map("poll_options")
}

model Vote {
  id           Int      @id @default(autoincrement())
  userId       String   @map("user_id")
  pollId       Int      @map("poll_id")
  pollOptionId Int      @map("poll_option_id")
  createdAt    DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id])
  pollOption PollOption @relation(fields: [pollOptionId], references: [id])
  poll       Poll       @relation(fields: [pollId], references: [id])

  @@unique([userId, pollOptionId], map: "uq_votes_user_poll_option")
  @@unique([userId, pollId], map: "uq_votes_user_poll") // đảm bảo mỗi người dùng chỉ được vote một lần cho mỗi poll
  @@index([userId], map: "idx_votes_user_id")
  @@index([pollOptionId], map: "idx_votes_poll_option_id")
  @@map("votes")
}

model PostMedia {
  id        Int              @id @default(autoincrement())
  postId    Int?             @map("post_id")
  url       String           @db.VarChar(2048)
  uploadUrl String?          @map("upload_url") @db.VarChar(2048) // url dùng để upload file, chỉ tồn tại khi media đang ở trạng thái TEMPORARY hoặc UPLOADING
  assetId   String?          @map("asset_id") @db.VarChar(255) // id của file trên dịch vụ lưu trữ, dùng để quản lý và xóa file khi cần thiết
  type      PostMediaType?   @map("type_enum")
  width     Int?
  height    Int?
  createdAt DateTime         @default(now()) @map("created_at")
  key       String           @unique @db.VarChar(255)
  status    PostMediaStatus? @default(TEMPORARY) @map("status_enum")
  post      Post?            @relation(fields: [postId], references: [id])

  @@index([postId], map: "idx_post_media_post_id")
  @@map("post_media")
}

model PostMention {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([postId, userId], map: "uq_post_mentions_post_user")
  @@index([postId], map: "idx_post_mentions_post_id")
  @@index([userId], map: "idx_post_mentions_user_id")
  @@map("post_mentions")
}

model Follow {
  id          Int          @id @default(autoincrement())
  userId      String       @map("user_id")
  followingId String       @map("following_id")
  isFollowing Boolean      @default(true) @map("is_following")
  status      FollowStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User @relation("FollowUser", fields: [userId], references: [id])
  following User @relation("FollowFollowing", fields: [followingId], references: [id])

  @@unique([userId, followingId])
  @@index([userId])
  @@index([followingId])
  @@index([followingId, status])
  @@map("follows")
}

model FriendRequest {
  id         Int                 @id @default(autoincrement())
  senderId   String              @map("sender_id")
  receiverId String              @map("receiver_id")
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  sender   User @relation("FriendRequestSender", fields: [senderId], references: [id])
  receiver User @relation("FriendRequestReceiver", fields: [receiverId], references: [id])

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@map("friend_requests")
}

model Like {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  postId    String   @map("post_id")
  isLike    Boolean  @default(false) @map("is_like")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [publicId])

  @@unique([userId, postId], map: "uq_likes_user_post")
  @@index([userId], map: "idx_likes_user_id")
  @@index([postId], map: "idx_likes_post_id")
  @@map("likes")
}

model Topic {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(255)
  count     Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  topicsPosts        TopicsPost[] @relation("TopicPublic")
  privateTopicsPosts TopicsPost[] @relation("TopicPrivate")

  @@index([name], map: "idx_topics_name")
  @@index([count], map: "idx_topics_count")
  @@fulltext([name], map: "idx_topics_name_fulltext")
  @@map("topics")
}

model TopicsPost {
  id             Int      @id @default(autoincrement())
  postId         Int      @map("post_id")
  topicId        Int?     @map("topic_id")
  privateTopicId Int?     @map("private_topic_id")
  isPublic       Boolean  @default(true) @map("is_public")
  createdAt      DateTime @default(now()) @map("created_at")

  post         Post   @relation(fields: [postId], references: [id])
  topic        Topic? @relation("TopicPublic", fields: [topicId], references: [id])
  privateTopic Topic? @relation("TopicPrivate", fields: [privateTopicId], references: [id])

  @@unique([postId], map: "uq_topics_posts_post_id")
  @@index([postId], map: "idx_topics_posts_post_id")
  @@index([topicId], map: "idx_topics_posts_topic_id")
  @@index([privateTopicId], map: "idx_topics_posts_private_topic_id")
  @@index([postId, topicId], map: "idx_topics_posts_post_topic")
  @@index([postId, privateTopicId], map: "idx_topics_posts_post_private_topic")
  @@map("topics_posts")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  token     String   @unique @db.VarChar(512)
  expireAt  DateTime @map("expire_at")
  sessionId String   @map("session_id") @db.VarChar(255)

  revokedAt DateTime? @map("revoked_at")

  userAgent String @default("unknown") @map("user_agent") @db.VarChar(512)
  ip        String @default("unknown") @db.VarChar(45)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId], map: "idx_refresh_tokens_user_id")
  @@index([expireAt], map: "idx_refresh_tokens_expire_at")
  @@index([sessionId], map: "idx_refresh_tokens_session_id")
  @@map("refresh_tokens")
}

model UserActionLog {
  id        Int        @id @default(autoincrement())
  userId    String     @map("user_id")
  type      ActionType @map("type_enum")
  targetId  String
  metadata  Json?
  createdAt DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, type, targetId], map: "uq_user_action_logs_user_type_target")
  @@index([userId], map: "idx_user_action_logs_user_id")
  @@index([type], map: "idx_user_action_logs_type")
  @@index([createdAt], map: "idx_user_action_logs_created_at")
  @@map("user_action_logs")
}

model LimitActionAI {
  id      Int        @id @default(autoincrement())
  userId  String     @map("user_id")
  type    ActionType @map("type_enum")
  count   Int        @default(5) // mặc định 5 lượt tạo imag,md
  resetAt DateTime   @map("reset_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId], map: "idx_limit_actions_user_id")
  @@index([type], map: "idx_limit_actions_type")
  @@index([resetAt], map: "idx_limit_actions_reset_at")
  @@map("limit_actions")
}

model UserRestriction {
  id        Int                 @id @default(autoincrement())
  userId    String              @map("user_id")
  type      UserRestrictionType @map("type_enum")
  reason    String?             @db.VarChar(255)
  expiresAt DateTime            @map("expires_at")
  createdAt DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId], map: "idx_user_restrictions_user_id")
  @@index([type], map: "idx_user_restrictions_type")
  @@index([expiresAt], map: "idx_user_restrictions_expires_at")
  @@map("user_restrictions")
}

