{
  "name": "@purse/root",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "prisma:generate": "pnpm -r --if-present prisma:generate",
    "build": "pnpm -r --if-present build",
    "build:auth-service": "pnpm --filter @purse/auth-service build",
    "build:workspace-service": "pnpm --filter @purse/workspace-service build",
    "dev:auth-service": "pnpm --filter @purse/auth-service dev",
    "dev:workspace-service": "pnpm --filter @purse/workspace-service dev"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.6",
    "typescript": "^5.8.0"
  }
}
