{
    "name": "threads-api-v2",
    "version": "1.0.0",
    "private": true,
    "description": "Express API with TypeScript, Prisma, and MySQL",
    "main": "dist/src/server.js",
    "scripts": {
        "dev": "tsx --watch src/server.ts",
        "server": "tsx src/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/src/server.js",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:push": "prisma db push",
        "db:pull": "prisma db pull",
        "db:studio": "prisma studio",
        "db:seed": "tsx prisma/seed.ts",
        "db:format": "prisma format",
        "worker": "tsx workers/index.ts",
        "queue": "tsx queues/index.ts",
        "start:prod": "node dist/src/server.js",
        "start:worker": "node dist/workers/index.js",
        "all:workers:queues": "npm run worker && npm run queue",
        "elastic:seed": "tsx scripts"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1041.0",
        "@aws-sdk/lib-storage": "^3.1041.0",
        "@elastic/elasticsearch": "^7.13.0",
        "@mixedbread-ai/sdk": "^2.2.11",
        "@mux/mux-node": "^14.0.1",
        "@openrouter/ai-sdk-provider": "^2.9.0",
        "@openrouter/sdk": "^0.12.35",
        "@pinecone-database/pinecone": "^7.2.0",
        "@prisma/adapter-mariadb": "^7.0.0",
        "@prisma/client": "^7.0.0",
        "@redis/bloom": "^5.12.1",
        "@types/ejs": "^3.1.5",
        "@types/nodemailer": "^8.0.0",
        "@types/swagger-ui-express": "^4.1.8",
        "ai": "^6.0.174",
        "bcrypt": "^6.0.0",
        "bullmq": "^5.76.4",
        "compression": "^1.8.1",
        "cors": "^2.8.5",
        "dotenv": "^16.5.0",
        "ejs": "^5.0.2",
        "express": "^5.1.0",
        "express-rate-limit": "^8.2.0",
        "helmet": "^8.0.0",
        "http-status-codes": "^2.3.0",
        "ioredis": "^5.10.1",
        "jsonwebtoken": "^9.0.3",
        "mariadb": "^3.4.5",
        "mixedbread-ai-provider": "^4.0.0",
        "morgan": "^1.10.0",
        "ms": "^2.1.3",
        "multer": "^2.1.1",
        "multer-s3": "^3.0.1",
        "nodemailer": "^8.0.7",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "pino-pretty": "^13.1.3",
        "pusher": "^5.3.3",
        "redis": "^5.12.1",
        "sharp": "^0.34.5",
        "swagger-ui-express": "^5.0.1",
        "tsconfig-paths": "^4.2.0",
        "uuid": "^14.0.0",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/compression": "^1.7.5",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "@types/ms": "^2.1.0",
        "@types/multer": "^2.1.0",
        "@types/multer-s3": "^3.0.3",
        "@types/node": "^22.0.0",
        "@types/sharp": "^0.31.1",
        "prisma": "^7.0.0",
        "tsx": "^4.19.0",
        "typescript": "^5.8.0"
    }
}