{
    "name": "threads-api-v2",
    "version": "1.0.0",
    "private": true,
    "packageManager": "pnpm@11.11.0",
    "description": "NestJS API with TypeScript, Prisma, and MySQL",
    "main": "dist/apps/api/src/main.js",
    "scripts": {
        "dev": "pnpm run build && concurrently --kill-others-on-fail --names tsc,aliases,api \"tsc --watch\" \"tsc-alias --watch\" \"node --watch --watch-preserve-output dist/apps/api/src/main.js\"",
        "server": "pnpm run build && node dist/apps/api/src/main.js",
        "build": "tsc && tsc-alias",
        "start": "node dist/apps/api/src/main.js",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "db:generate": "prisma generate --config apps/api/prisma.config.ts",
        "db:migrate": "prisma migrate dev --config apps/api/prisma.config.ts",
        "db:push": "prisma db push --config apps/api/prisma.config.ts",
        "db:pull": "prisma db pull --config apps/api/prisma.config.ts",
        "db:studio": "prisma studio --config apps/api/prisma.config.ts",
        "db:format": "prisma format --config apps/api/prisma.config.ts",
        "db:seed": "prisma db seed --config apps/api/prisma.config.ts",
        "worker": "pnpm run build && node dist/apps/workers/src/main.js",
        "start:prod": "node dist/apps/api/src/main.js",
        "start:worker": "node dist/apps/workers/src/index.js",
        "all:workers:queues": "pnpm run worker",
        "docs:routes": "node scripts/generate-docs-routes.mjs"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1041.0",
        "@aws-sdk/lib-storage": "^3.1041.0",
        "@aws-sdk/s3-request-presigner": "^3.1068.0",
        "@google/genai": "^2.7.0",
        "@nestjs/bullmq": "^11.0.5",
        "@nestjs/common": "^11.1.28",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^11.1.28",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/platform-express": "^11.1.28",
        "@nestjs/swagger": "^11.4.6",
        "@openrouter/ai-sdk-provider": "^2.9.0",
        "@openrouter/sdk": "^0.12.35",
        "@prisma/adapter-mariadb": "7.8.0",
        "@prisma/client": "7.8.0",
        "@redis/bloom": "^5.12.1",
        "@types/ejs": "^3.1.5",
        "@types/nodemailer": "^8.0.0",
        "ai": "^6.0.174",
        "bcrypt": "^6.0.0",
        "bullmq": "^5.81.3",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "dotenv": "^16.5.0",
        "ejs": "^5.0.2",
        "ffmpeg-ffprobe-static": "^6.1.2-rc.1",
        "ffmpeg-static": "^5.3.0",
        "fluent-ffmpeg": "^2.1.3",
        "groq-sdk": "^1.2.1",
        "helmet": "^8.3.0",
        "http-status-codes": "^2.3.0",
        "ioredis": "^5.10.1",
        "jsonwebtoken": "^9.0.3",
        "mariadb": "^3.4.5",
        "mongodb": "^7.5.0",
        "morgan": "^1.11.0",
        "ms": "^2.1.3",
        "multer-s3": "^3.0.1",
        "nodemailer": "^8.0.7",
        "pusher": "^5.3.3",
        "redis": "^5.12.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "sharp": "^0.34.5",
        "tsconfig-paths": "^4.2.0",
        "uuid": "^14.0.0",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/fluent-ffmpeg": "^2.1.28",
        "@types/helmet": "^4.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "@types/ms": "^2.1.0",
        "@types/multer": "^2.2.0",
        "@types/multer-s3": "^3.0.3",
        "@types/node": "^22.20.1",
        "@types/sharp": "^0.31.1",
        "concurrently": "^10.0.4",
        "graceful-fs": "^4.2.11",
        "prisma": "7.8.0",
        "tsc-alias": "^1.8.17",
        "tsx": "^4.19.0",
        "typescript": "^5.8.0"
    }
}
