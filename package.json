{
  "name": "@purse/root",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.26.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "prisma:generate": "pnpm -r --if-present prisma:generate",
    "build:account-service": "turbo run build --filter=@purse/account-service",
    "build:workspace-service": "turbo run build --filter=@purse/workspace-service",
    "build:packages": "turbo run build --filter=\"./packages/*\"",
    "start:account-service": "pnpm --filter @purse/account-service start",
    "build:core": "turbo run build --filter=@purse/core",
    "dev:workspace-service": "pnpm --filter @purse/workspace-service dev",
    "test:integration:auth": "tsx --test tests/integration/auth/kong-jwt.e2e-spec.ts",
    "test:integration:auth-post": "tsx --test tests/integration/flows/kong-auth-post.e2e-spec.ts",
    "compose:up:dev": "docker compose --env-file .env -f deploy/compose/compose.yaml -f deploy/compose/overlays/dev.yaml up -d",
    "compose:down:dev": "docker compose --env-file .env -f deploy/compose/compose.yaml -f deploy/compose/overlays/dev.yaml down",
    "compose:recreate:dev": "docker compose --env-file .env -f deploy/compose/compose.yaml -f deploy/compose/overlays/dev.yaml  up -d --no-deps --force-recreate"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@types/node": "^22.20.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.6",
    "turbo": "^2.11.7",
    "typescript": "^5.8.0"
  }
}
